    {
      "name": "mask: regex and keyword in multimodal text parts, log-only finding",
      "hook": "ingress",
      "args": [
        {
          "stage": "ingress",
          "format": "openai",
          "path": "/v1/chat/completions",
          "model": "gpt-4o-mini",
          "attempt": 0,
          "instance": {
            "id": "fixture",
            "name": "fixture"
          },
          "config": {
            "blockCategory": "blocked",
            "maskCategory": "masked",
            "logCategory": "flagged",
            "keywordsCaseSensitive": false,
            "rules": [
              {
                "type": "regex",
                "action": "mask",
                "category": "pii",
                "scope": "both",
                "caseSensitive": false,
                "id": "id-number",
                "pattern": "\\b[1-9]\\d{16}[0-9Xx]\\b"
              },
              {
                "type": "keyword",
                "action": "mask",
                "category": "codename",
                "scope": "both",
                "caseSensitive": false,
                "id": "falcon",
                "pattern": "project falcon"
              },
              {
                "type": "regex",
                "action": "log",
                "category": "support",
                "scope": "both",
                "caseSensitive": false,
                "id": "watch",
                "pattern": "(?i)REFUND"
              }
            ],
            "disabledCategories": [],
            "checkPrompts": true,
            "promptScope": "all",
            "checkAttachments": false,
            "checkReplies": true,
            "normalize": true,
            "blockMessage": "",
            "replyMessage": "",
            "maskText": "[x]",
            "streamHold": 0,
            "maxScanChars": 1000000,
            "oversize": "scan_head"
          }
        },
        {
          "body": {
            "model": "gpt-4o-mini",
            "stream": false,
            "messages": [
              {
                "role": "user",
                "content": [
                  {
                    "type": "text",
                    "text": "ID 11010519491231002X, Project ​Falcon? Refund please"
                  },
                  {
                    "type": "image_url",
                    "image_url": {
                      "url": "[media:0]"
                    }
                  },
                  {
                    "type": "text",
                    "text": "ＰＲＯＪＥＣＴ ＦＡＬＣＯＮ"
                  }
                ]
              }
            ]
          }
        }
      ],
      "expected": {
        "action": "continue",
        "effects": [
          {
            "type": "json.patch",
            "ops": [
              {
                "op": "replace",
                "path": "/messages/0/content/0/text",
                "value": "ID [x], [x]? Refund please"
              },
              {
                "op": "replace",
                "path": "/messages/0/content/2/text",
                "value": "[x]"
              }
            ]
          }
        ],
        "notice": {
          "en": "Some text in the request was masked by the content policy",
          "zh": "请求中的部分文本已按内容策略遮盖"
        },
        "findings": [
          {
            "rule": "id-number",
            "category": "pii",
            "count": 1
          },
          {
            "rule": "falcon",
            "category": "codename",
            "count": 2
          },
          {
            "rule": "watch",
            "category": "support",
            "count": 1
          }
        ]
      }
    },
