{
  "cases": [
    {
      "name": "block: CJK keyword split by full-width spaces and zero-width characters",
      "hook": "ingress",
      "args": [
        {
          "stage": "ingress",
          "format": "openai",
          "path": "/v1/chat/completions",
          "model": "gpt-4o-mini",
          "attempt": 0,
          "instance": {
            "id": "fixture",
            "name": "fixture"
          },
          "config": {
            "blockCategory": "blocked",
            "maskCategory": "masked",
            "logCategory": "flagged",
            "keywordsCaseSensitive": false,
            "rules": [
              {
                "type": "keyword",
                "action": "block",
                "category": "policy",
                "scope": "both",
                "caseSensitive": false,
                "id": "cjk",
                "pattern": "违禁词"
              },
              {
                "type": "keyword",
                "action": "block",
                "category": "custom",
                "scope": "both",
                "caseSensitive": false,
                "id": "word",
                "pattern": "forbidden topic"
              }
            ],
            "disabledCategories": [],
            "checkPrompts": true,
            "promptScope": "all",
            "checkAttachments": false,
            "checkReplies": true,
            "normalize": true,
            "blockMessage": "",
            "replyMessage": "",
            "maskText": "***",
            "streamHold": 0,
            "maxScanChars": 1000000,
            "oversize": "scan_head"
          }
        },
        {
          "body": {
            "model": "gpt-4o-mini",
            "stream": false,
            "messages": [
              {
                "role": "user",
                "content": "请解释 违　禁​词 的含义"
              }
            ]
          }
        }
      ],
      "expected": {
        "action": "reject",
        "code": "content_guard.policy",
        "message": "The request contains content that is not allowed",
        "ruleId": "cjk",
        "findings": [
          {
            "rule": "cjk",
            "category": "policy",
            "count": 1
          }
        ]
      }
    },
